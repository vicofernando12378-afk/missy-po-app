---
import '../index.css';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer';
import WhatsAppFloat from '../components/shared/WhatsAppFloat';
import CartFloat from '../components/shared/CartFloat';
import CartDrawer from '../components/cart/CartDrawer';
import { getImage } from 'astro:assets';
import logoHeaderImg from '../assets/logoheader.jpeg';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { 
  title = "Missy & Po — Pet Shop | Accesorios y Ropa para Mascotas en Perú", 
  description = "Missy & Po, la tienda online #1 de accesorios, ropa y juguetes para mascotas en Perú. Envíos a todo el país con Courier Shalom y Olva Express. ¡Consiéntelos como se merecen!",
  canonical
} = Astro.props;

// Canonical URL: usar prop si se provee, si no generar desde la ruta actual
const canonicalUrl = canonical || `https://missypoweb.web.app${Astro.url.pathname}`;

// Optimizar logo a formato WebP conservando las dimensiones originales
const optimizedLogo = await getImage({ src: logoHeaderImg, format: 'webp' });
const logoUrl = optimizedLogo.src;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="pet shop, tienda mascotas, accesorios mascotas, ropa perros, Perú, envío nacional" />
    <meta name="author" content="Missy & Po Pet Shop" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/og-image.jpg" />
    
    <!-- Schema LocalBusiness (SEO Local / GEO) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "PetStore",
      "name": "Missy & Po Pet Shop",
      "description": "Tienda online de accesorios, ropa y juguetes premium para mascotas en Arequipa, Perú.",
      "url": "https://missypoweb.web.app",
      "logo": "https://missypoweb.web.app/assets/logoheader.png",
      "image": "https://missypoweb.web.app/assets/og-image.jpg",
      "telephone": "+51913249330",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Diagonal Frente a Promelsa, Cooperativa Universitaria Mz I Lt 1",
        "addressLocality": "Arequipa",
        "addressRegion": "Arequipa",
        "addressCountry": "PE",
        "postalCode": "04001"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -16.4,
        "longitude": -71.53
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "08:00",
          "closes": "18:00"
        }
      ],
      "priceRange": "$$",
      "currenciesAccepted": "PEN",
      "paymentAccepted": "Yape, Plin, Mercado Pago, Credit Card, Cash on Delivery",
      "hasMap": "https://www.google.com/maps",
      "sameAs": [
        "https://www.tiktok.com/@missynpo",
        "https://www.instagram.com/missynpo.petshop",
        "https://www.facebook.com/missynpopetshop"
      ]
    })} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Pacifico&family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    <!-- Navbar Interactivo (React Island) -->
    <Navbar client:load logoUrl={logoUrl} />

    <main class="flex-1 print:p-0">
      <slot />
    </main>

    <!-- Footer Estático (Sin JS) -->
    <div class="print:hidden">
      <Footer logoUrl={logoUrl} />
    </div>

    <!-- Flotantes y Overlays globales -->
    <div class="print:hidden">
      <WhatsAppFloat />
      <CartFloat client:load />
      <CartDrawer client:load />
    </div>
  </body>
</html>

