---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import imgPuntos from '../assets/club/Mypo_puntos.jpeg';
import imgDescuentos from '../assets/club/descuentos.jpeg';
import imgCumple from '../assets/club/cumple.jpeg';
import imgExclusivo from '../assets/club/exclusivo.jpeg';
import imgYoutube from '../assets/club/youtube.jpeg';
import imgEnvio from '../assets/club/enviorapido.jpeg';
---

<Layout
  title="Club de Beneficios Missy & Po | Pet Shop Arequipa"
  description="Únete al Club de Beneficios Missy & Po. Acumula Superpuntos, accede a descuentos exclusivos y protege a tu mascota con seguros de salud. ¡Tu peludo merece lo mejor!"
>

  {/* === HERO === */}
  <section class="relative overflow-hidden py-20 px-4" style="background: linear-gradient(135deg, #fff5f5 0%, #fff8ec 50%, #fff5f5 100%);">
    {/* Decoración de fondo */}
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-10 -right-10 w-64 h-64 rounded-full opacity-20" style="background: var(--color-coral);"></div>
      <div class="absolute -bottom-16 -left-16 w-96 h-96 rounded-full opacity-10" style="background: var(--color-gold);"></div>
    </div>

    <div class="relative max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Columna de Texto -->
        <div class="lg:col-span-7 text-center lg:text-left">
          {/* Badge */}
          <div class="inline-flex items-center gap-2 bg-white border text-xs font-ui font-bold uppercase tracking-widest px-4 py-2 rounded-full shadow-sm mb-6" style="border-color: var(--color-coral); color: var(--color-coral);">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            Club Exclusivo para Miembros
          </div>

          <h1 class="font-hero text-4xl sm:text-5xl lg:text-6xl mb-6 leading-tight" style="color: var(--color-text-dark);">
            Club de Beneficios<br/>
            <span style="color: var(--color-coral);">Missy &amp; Po</span>
          </h1>

          <p class="text-base sm:text-lg mb-8 leading-relaxed font-body" style="color: var(--color-text-gray);">
            ¡Haz que cada compra cuente! Acumula Missy & Po Puntos, accede a descuentos exclusivos y protege la salud de tu mascota con beneficios únicos diseñados para ti y tu peludo.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center">
            <button
              class="cta-club-trigger inline-flex items-center gap-2 font-ui font-bold text-white px-8 py-4 rounded-full shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-xl text-sm cursor-pointer"
              style="background: linear-gradient(135deg, var(--color-coral), var(--color-coral-dark));"
              data-benefit="Club de Beneficios"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Quiero unirme al Club
            </button>
            <a
              href="/tienda"
              class="inline-flex items-center gap-2 font-ui font-semibold bg-white border-2 px-8 py-4 rounded-full transition-all duration-300 text-sm hover:shadow-md"
              style="border-color: var(--color-coral); color: var(--color-coral);"
            >
              Ver tienda
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Columna de Imagen -->
        <div class="lg:col-span-5 relative">
          <div class="absolute -inset-2 rounded-3xl bg-gradient-to-br from-red-200 to-amber-200 opacity-30 blur-lg"></div>
          <div class="relative bg-white rounded-3xl overflow-hidden shadow-lg border border-gray-100 p-3">
            <img
              src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&q=80&w=800"
              alt="Mascota feliz de Missy & Po"
              class="w-full h-80 sm:h-96 object-cover rounded-2xl"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* === BENEFICIOS PRINCIPALES === */}
  <section class="py-20 px-4 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="font-hero text-3xl sm:text-4xl mb-4" style="color: var(--color-text-dark);">
          ¿Qué incluye el Club?
        </h2>
        <p class="font-body max-w-xl mx-auto" style="color: var(--color-text-gray);">
          Todos los beneficios diseñados para que tú y tu mascota vivan la mejor experiencia.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

        {/* Benefit 1: Missy & Po Puntos */}
        <div class="group relative bg-white border border-gray-100 rounded-3xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="relative h-40 overflow-hidden">
            <Image
              src={imgPuntos}
              alt="Puntos y recompensas para mascotas"
              width={400}
              height={160}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            <div class="absolute top-3 left-3 w-10 h-10 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, var(--color-gold), #f59e0b);">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-ui font-bold text-gray-800 text-base mb-2">Missy &amp; Po Puntos</h3>
            <p class="text-gray-500 text-sm font-body leading-relaxed mb-4">
              Acumula puntos en cada compra y canjéalos por descuentos o productos gratis.
            </p>
            <button data-benefit="Missy & Po Puntos" class="cta-club-trigger inline-flex items-center gap-1 text-sm font-ui font-bold transition-all duration-200 hover:translate-x-1 cursor-pointer" style="color: var(--color-coral);">¡Empieza a acumular puntos hoy! →</button>
          </div>
        </div>

        {/* Benefit 2: Descuentos exclusivos */}
        <div class="group relative bg-white border border-gray-100 rounded-3xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="relative h-40 overflow-hidden">
            <Image
              src={imgDescuentos}
              alt="Descuentos exclusivos para miembros"
              width={400}
              height={160}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            <div class="absolute top-3 left-3 w-10 h-10 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, var(--color-coral), var(--color-coral-dark));">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M17 17h.01M9 12l2 2 4-4m-1.5-7A8.5 8.5 0 115.5 18.5 8.5 8.5 0 0117.5 5z"/></svg>
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-ui font-bold text-gray-800 text-base mb-2">Descuentos Exclusivos</h3>
            <p class="text-gray-500 text-sm font-body leading-relaxed mb-4">
              Promociones anticipadas y ofertas especiales que solo están disponibles para miembros del Club.
            </p>
            <button data-benefit="Descuentos Exclusivos" class="cta-club-trigger inline-flex items-center gap-1 text-sm font-ui font-bold transition-all duration-200 hover:translate-x-1 cursor-pointer" style="color: var(--color-coral);">¡Quiero mis ofertas exclusivas! →</button>
          </div>
        </div>

        {/* Benefit 3: Cumpleaños */}
        <div class="group relative bg-white border border-gray-100 rounded-3xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="relative h-40 overflow-hidden">
            <Image
              src={imgCumple}
              alt="Regalo de cumpleaños para tu mascota"
              width={400}
              height={160}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            <div class="absolute top-3 left-3 w-10 h-10 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, #8b5cf6, #a78bfa);">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0M3 5a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2H5a2 2 0 01-2-2V5z"/></svg>
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-ui font-bold text-gray-800 text-base mb-2">Regalo de Cumpleaños</h3>
            <p class="text-gray-500 text-sm font-body leading-relaxed mb-4">
              El mes del cumpleaños de tu mascota te enviamos una sorpresa exclusiva para celebrar juntos.
            </p>
            <button data-benefit="Regalo de Cumpleaños" class="cta-club-trigger inline-flex items-center gap-1 text-sm font-ui font-bold transition-all duration-200 hover:translate-x-1 cursor-pointer" style="color: var(--color-coral);">¡Asegura la sorpresa de tu mascota! →</button>
          </div>
        </div>

        {/* Benefit 4: Acceso anticipado */}
        <div class="group relative bg-white border border-gray-100 rounded-3xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="relative h-40 overflow-hidden">
            <Image
              src={imgExclusivo}
              alt="Acceso anticipado a nuevos productos"
              width={400}
              height={160}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            <div class="absolute top-3 left-3 w-10 h-10 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, #14b8a6, #34d399);">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-ui font-bold text-gray-800 text-base mb-2">Acceso Anticipado</h3>
            <p class="text-gray-500 text-sm font-body leading-relaxed mb-4">
              Sé el primero en conocer nuevos productos y lanzamientos antes que cualquier otro.
            </p>
            <button data-benefit="Acceso Anticipado" class="cta-club-trigger inline-flex items-center gap-1 text-sm font-ui font-bold transition-all duration-200 hover:translate-x-1 cursor-pointer" style="color: var(--color-coral);">¡Sé el primero en ver lanzamientos! →</button>
          </div>
        </div>

        {/* Benefit 5: Contenido VIP */}
        <div class="group relative bg-white border border-gray-100 rounded-3xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="relative h-40 overflow-hidden">
            <Image
              src={imgYoutube}
              alt="Contenido exclusivo Missy &amp; Po TV"
              width={400}
              height={160}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            <div class="absolute top-3 left-3 w-10 h-10 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, #3b82f6, #6366f1);">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.069A1 1 0 0121 8.876V15.124a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-ui font-bold text-gray-800 text-base mb-2">Contenido Missy &amp; Po TV</h3>
            <p class="text-gray-500 text-sm font-body leading-relaxed mb-4">
              Videos exclusivos, tutoriales y tips de cuidado por expertos. Solo para miembros del Club.
            </p>
            <button data-benefit="Contenido Missy & Po TV" class="cta-club-trigger inline-flex items-center gap-1 text-sm font-ui font-bold transition-all duration-200 hover:translate-x-1 cursor-pointer" style="color: var(--color-coral);">¡Accede a videos exclusivos! →</button>
          </div>
        </div>

        {/* Benefit 6: Soporte prioritario */}
        <div class="group relative bg-white border border-gray-100 rounded-3xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="relative h-40 overflow-hidden">
            <Image
              src={imgEnvio}
              alt="Atención prioritaria por WhatsApp VIP"
              width={400}
              height={160}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            <div class="absolute top-3 left-3 w-10 h-10 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, #f97316, #fb923c);">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-ui font-bold text-gray-800 text-base mb-2">Atención Prioritaria</h3>
            <p class="text-gray-500 text-sm font-body leading-relaxed mb-4">
              Tus consultas y pedidos se atienden con prioridad absoluta via canal directo WhatsApp VIP.
            </p>
            <button data-benefit="Atención Prioritaria" class="cta-club-trigger inline-flex items-center gap-1 text-sm font-ui font-bold transition-all duration-200 hover:translate-x-1 cursor-pointer" style="color: var(--color-coral);">¡Activa tu soporte VIP preferencial! →</button>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* === SEGUROS DE SALUD — ALIANZA ESTRATÉGICA === */}
  <section class="py-24 px-4 relative overflow-hidden" style="background: linear-gradient(135deg, #1F2937, #111827);">
    {/* Decoración */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10" style="background: var(--color-coral); filter: blur(80px);"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full opacity-10" style="background: var(--color-gold); filter: blur(80px);"></div>
    </div>

    <div class="relative max-w-6xl mx-auto">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        {/* Texto */}
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-ui font-bold uppercase tracking-widest px-4 py-2 rounded-full mb-6" style="background: rgba(229,106,106,0.15); border: 1px solid rgba(229,106,106,0.3); color: var(--color-coral-light);">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            Próximamente — Seguro para Mascotas
          </div>

          <h2 class="font-hero text-3xl sm:text-4xl text-white mb-6 leading-tight">
            Protege la salud de tu mascota con un
            <span style="color: var(--color-gold);"> seguro de salud</span>
          </h2>

          <p class="font-body leading-relaxed mb-6 text-base" style="color: #9CA3AF;">
            Estamos cerrando alianzas con las mejores aseguradoras peruanas para ofrecerte coberturas de salud veterinaria pensadas para perros y gatos. Como miembro del Club Missy & Po, tendrás acceso a <strong class="text-white">tarifas preferenciales</strong> y beneficios exclusivos que no encontrarás en ningún otro lado.
          </p>

          <div class="relative rounded-2xl overflow-hidden h-48 mb-6 shadow-sm border border-gray-700">
            <img
              src="https://images.unsplash.com/photo-1628009368231-7bb7cfcb0def?auto=format&fit=crop&w=800&q=80"
              alt="Veterinario revisando mascota"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 to-transparent"></div>
            <span class="absolute bottom-3 left-4 text-xs font-ui font-semibold text-white">Próximamente: Tu tranquilidad y su salud en las mejores manos</span>
          </div>

          <ul class="space-y-4 mb-8">
            {[
              'Consultas veterinarias cubiertas',
              'Emergencias y hospitalización',
              'Cirugías y procedimientos especializados',
              'Vacunas y medicina preventiva',
              'Descuento adicional por ser miembro del Club',
            ].map(text => (
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5 text-white" style="background: var(--color-coral);">✓</span>
                <span class="font-body text-sm" style="color: #D1D5DB;">{text}</span>
              </li>
            ))}
          </ul>

          <a
            href="https://wa.me/51999999999?text=Hola!%20quiero%20informarme%20sobre%20el%20seguro%20de%20salud%20para%20mi%20mascota"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-ui font-bold text-white px-8 py-4 rounded-full shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-2xl text-sm"
            style="background: linear-gradient(135deg, var(--color-coral), var(--color-coral-dark));"
          >
