  {/* === MODAL DE REGISTRO CLUB === */}
  <div
    id="club-register-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300"
  >
    <div class="modal-card relative w-full max-w-md bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden transform scale-95 transition-transform duration-300 p-8">
      {/* Botón de cerrar */}
      <button
        id="modal-close-btn"
        class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors p-2 rounded-full hover:bg-gray-50 cursor-pointer"
        aria-label="Cerrar modal"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      {/* Canvas para confeti */}
      <canvas id="confetti-canvas" class="absolute inset-0 pointer-events-none w-full h-full z-10"></canvas>

      <div class="relative z-20">
        <div class="inline-flex items-center gap-1.5 bg-red-50 text-xs font-ui font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full mb-4" style="color: var(--color-coral); border: 1px solid rgba(229,106,106,0.2);">
          🐾 Club Missy & Po
        </div>

        <h3 class="font-hero text-2xl mb-1 text-gray-800">
          ¡Bienvenido al Club!
        </h3>
        <p class="text-xs text-gray-500 font-body mb-6">
          Regístrate para activar tu beneficio: <span id="modal-benefit-name" class="font-bold" style="color: var(--color-coral);"></span>
        </p>

        {/* Formulario */}
        <form id="club-register-form" class="space-y-4">
          <div>
            <label for="tutor-name" class="block text-xs font-ui font-bold text-gray-600 uppercase mb-1.5">Tu Nombre completo</label>
            <input
              type="text"
              id="tutor-name"
              required
              placeholder="Ej. Victor Chávez"
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-red-200 focus:border-red-400 text-sm transition-all animate-none"
            />
          </div>

          <div>
            <label for="pet-name" class="block text-xs font-ui font-bold text-gray-600 uppercase mb-1.5">Nombre de tu mascota (alias en el Club)</label>
            <input
              type="text"
              id="pet-name"
              required
              placeholder="Ej. Missy"
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-red-200 focus:border-red-400 text-sm transition-all animate-none"
            />
          </div>

          <div>
            <label for="tutor-email" class="block text-xs font-ui font-bold text-gray-600 uppercase mb-1.5">Tu Correo electrónico</label>
            <input
              type="email"
              id="tutor-email"
              required
              placeholder="Ej. victor@example.com"
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-red-200 focus:border-red-400 text-sm transition-all animate-none"
            />
          </div>

          <p class="text-[10px] text-gray-400 leading-relaxed font-body pt-1">
            Al unirte, aceptas que tu información sea almacenada de forma segura para gestionar los beneficios de tu mascota y enviarte sorpresas exclusivas.
          </p>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3.5 mt-2 text-white font-ui font-bold rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 flex items-center justify-center gap-2 text-sm cursor-pointer border-none"
            style="background: linear-gradient(135deg, var(--color-coral), var(--color-coral-dark));"
          >
            ¡Unirme al Club! ✨
          </button>
        </form>

        {/* Estado de Éxito */}
        <div id="success-state" class="hidden flex flex-col items-center text-center py-6 space-y-4">
          <div class="w-20 h-20 bg-green-50 rounded-full flex items-center justify-center border border-green-100 shadow-inner animate-bounce">
            <span class="text-4xl">🎉</span>
          </div>
          <h4 class="font-hero text-2xl text-green-600">¡Registro Exitoso!</h4>
          <p class="text-sm font-body text-gray-600 max-w-xs mx-auto">
            ¡Bienvenido, <span id="success-pet-name" class="font-bold text-coral"></span>! Tú y tu tutor ya son miembros oficiales. Pronto recibirán sus beneficios.
          </p>
          <div class="text-xs font-ui text-gray-400 animate-pulse pt-4">
            Esta ventana se cerrará automáticamente...
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { db } from '../services/firebase';
    import { collection, addDoc, serverTimestamp } from 'firebase/firestore';

    const modal = document.getElementById('club-register-modal');
    const modalBenefitName = document.getElementById('modal-benefit-name');
    const closeBtn = document.getElementById('modal-close-btn');
    const registerForm = document.getElementById('club-register-form') as HTMLFormElement;
    const successState = document.getElementById('success-state');
    const successPetName = document.getElementById('success-pet-name');
    const submitBtn = document.getElementById('submit-btn');

    let currentBenefit = '';

    // Abrir modal
    document.querySelectorAll('.cta-club-trigger').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const btn = trigger as HTMLButtonElement;
        currentBenefit = btn.getAttribute('data-benefit') || 'Club Missy & Po';
        
        if (modalBenefitName) {
          modalBenefitName.textContent = currentBenefit;
        }
        
        // Resetear estado del formulario
        if (registerForm) {
          registerForm.reset();
          registerForm.classList.remove('hidden');
        }
        if (successState) successState.classList.add('hidden');
        if (submitBtn) {
          (submitBtn as HTMLButtonElement).disabled = false;
          submitBtn.innerHTML = '¡Unirme al Club! ✨';
        }

        // Mostrar modal con transición suave
        if (modal) {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          const card = modal.querySelector('.modal-card');
          if (card) card.classList.remove('scale-95');
        }
      });
    });

    // Cerrar modal
    function closeModal() {
      if (modal) {
        modal.classList.add('opacity-0', 'pointer-events-none');
        const card = modal.querySelector('.modal-card');
        if (card) card.classList.add('scale-95');
      }
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    }

    // Animación de Confeti de última generación en Canvas
    function launchConfetti() {
      const canvas = document.getElementById('confetti-canvas') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      canvas.width = canvas.parentElement?.clientWidth || 400;
      canvas.height = canvas.parentElement?.clientHeight || 450;

      const colors = ['#e56a6a', '#f59e0b', '#8b5cf6', '#14b8a6', '#3b82f6', '#f97316'];
      const particles: any[] = [];

      for (let i = 0; i < 70; i++) {
        particles.push({
          x: canvas.width / 2 + (Math.random() - 0.5) * 40,
          y: canvas.height / 2 + 20,
          vx: (Math.random() - 0.5) * 12,
          vy: -Math.random() * 12 - 4,
          color: colors[Math.floor(Math.random() * colors.length)],
          size: Math.random() * 8 + 6,
          rotation: Math.random() * 360,
          rotationSpeed: (Math.random() - 0.5) * 15,
          opacity: 1
        });
      }

      function animate() {
        ctx!.clearRect(0, 0, canvas.width, canvas.height);
        let active = false;

        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.25; // Gravedad
          p.vx *= 0.98; // Resistencia
          p.rotation += p.rotationSpeed;

          if (p.opacity > 0.01 && p.y < canvas.height) {
            active = true;
          }

          ctx!.save();
          ctx!.translate(p.x, p.y);
          ctx!.rotate((p.rotation * Math.PI) / 180);
          ctx!.fillStyle = p.color;
          ctx!.globalAlpha = p.opacity;
          ctx!.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
          ctx!.restore();

          if (p.vy > 1) {
            p.opacity -= 0.015;
            if (p.opacity < 0) p.opacity = 0;
          }
        });

        if (active) {
          requestAnimationFrame(animate);
        }
      }

      animate();
    }

    // Submit del Formulario
    if (registerForm) {
      registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const tutorNameInput = document.getElementById('tutor-name') as HTMLInputElement;
        const petNameInput = document.getElementById('pet-name') as HTMLInputElement;
        const emailInput = document.getElementById('tutor-email') as HTMLInputElement;

        if (!tutorNameInput || !petNameInput || !emailInput) return;

        const tutorName = tutorNameInput.value.trim();
        const petName = petNameInput.value.trim();
        const email = emailInput.value.trim();

        if (!tutorName || !petName || !email) return;

        if (submitBtn) {
          (submitBtn as HTMLButtonElement).disabled = true;
          submitBtn.innerHTML = `
            <svg class="animate-spin h-5 w-5 text-white inline-block mr-2" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Procesando...
          `;
        }

        try {
          await addDoc(collection(db, 'myp_club_miembros'), {
            nombre_tutor: tutorName,
            nombre_mascota: petName,
            email: email,
            benefit_origen: currentBenefit,
            creado_en: serverTimestamp()
          });

          // Ocultar formulario, mostrar éxito
          if (registerForm) registerForm.classList.add('hidden');
          if (successState) successState.classList.remove('hidden');
          if (successPetName) successPetName.textContent = petName;

          // Lanzar animación confeti
          launchConfetti();

          // Cerrar modal automáticamente tras 3 segundos
          setTimeout(() => {
            closeModal();
          }, 3000);

        } catch (error) {
          console.error('Error al unirse al club:', error);
          alert('Hubo un inconveniente al unirte al club. Por favor, vuelve a intentarlo.');
          if (submitBtn) {
            (submitBtn as HTMLButtonElement).disabled = false;
            submitBtn.innerHTML = '¡Unirme al Club! ✨';
          }
        }
      });
    }
  </script>
</Layout>
