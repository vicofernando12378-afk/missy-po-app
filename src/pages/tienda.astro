---
import Layout from '../layouts/Layout.astro';
import StorePage from './StorePage.jsx';
import { obtenerProductos } from '../services/firestore.js';

// Pre-cargar catálogo completo a nivel de servidor (Build-time)
const { productos: initialProducts } = await obtenerProductos({ paginaSize: 100 });
---

<Layout 
  title="Tienda de Alimentos, Accesorios y Juguetes para Mascotas | Missy & Po"
  description="Explora el catálogo completo de Missy & Po Pet Shop. Tenemos la mejor selección de accesorios, ropa, camas y juguetes premium para perros y gatos en Perú."
>
  <StorePage client:load initialProducts={initialProducts} />
</Layout>
