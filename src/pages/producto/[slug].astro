---
import Layout from '../../layouts/Layout.astro';
import ProductPage from '../../pages/ProductPage.jsx';
import { obtenerProductoPorSlug, obtenerTodosProductosAdmin } from '../../services';


export async function getStaticPaths() {
  try {
    const productos = await obtenerTodosProductosAdmin();
    // Devolver paths válidos filtrando slugs vacíos
    return productos
      .filter(p => p.slug)
      .map(p => ({
        params: { slug: p.slug },
      }));
  } catch (err) {
    console.error('Error al generar getStaticPaths en producto:', err);
    return [];
  }
}

const { slug } = Astro.params;

// Consultar Firestore en tiempo de compilación para pre-renderizar metatags SEO
let product = null;
if (slug) {
  product = await obtenerProductoPorSlug(slug);
}

const serializedProduct = product ? JSON.parse(JSON.stringify(product)) : null;

const title = product 
  ? `${product.nombre} | Missy & Po Pet Shop`
  : "Producto no encontrado | Missy & Po Pet Shop";

const description = product 
  ? (product.descripcion_corta || product.descripcion?.replace(/<[^>]*>/g, '').substring(0, 155) || `Compra ${product.nombre} al mejor precio en Missy & Po Pet Shop. Accesorios premium para mascotas en Perú.`)
  : "El producto que buscas no existe o ha sido retirado de Missy & Po Pet Shop.";
---

<Layout title={title} description={description}>
  {product && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": product.nombre,
      "description": product.descripcion?.replace(/<[^>]*>/g, '').substring(0, 500),
      "image": product.imagenes?.[0],
      "sku": product.sku,
      "brand": {
        "@type": "Brand",
        "name": "Missy & Po"
      },
      "offers": {
        "@type": "Offer",
        "url": `https://missypoweb.web.app/producto/${product.slug}`,
        "priceCurrency": "PEN",
        "price": product.precio_oferta || product.precio_regular,
        "availability": product.stock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
        "seller": {
          "@type": "Organization",
          "name": "Missy & Po Pet Shop"
        }
      },
      "aggregateRating": product.rating ? {
        "@type": "AggregateRating",
        "ratingValue": product.rating,
        "reviewCount": product.reviewCount || 1
      } : undefined
    })} />
  )}
  <ProductPage slug={slug} initialProduct={serializedProduct} client:load />
</Layout>
