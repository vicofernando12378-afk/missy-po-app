---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto | Missy & Po Pet Shop"
  description="Contáctanos por WhatsApp, Telegram o nuestro formulario. Estamos en Arequipa con envíos a todo el Perú."
>

  {/* === HERO === */}
  <section class="relative overflow-hidden py-16 px-4" style="background: linear-gradient(135deg, #fff5f5 0%, #fff8ec 50%, #fff5f5 100%);">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-10 -right-10 w-64 h-64 rounded-full opacity-20" style="background: var(--color-coral);"></div>
    </div>
    <div class="relative max-w-7xl mx-auto text-center">
      <h1 class="font-hero text-3xl sm:text-4xl lg:text-5xl mb-4" style="color: var(--color-text-dark);">
        ¿Cómo te podemos <span style="color: var(--color-coral);">ayudar</span>?
      </h1>
      <p class="font-body text-gray-500 max-w-lg mx-auto">
        Elegí el canal que más te guste. Respondemos rápido.
      </p>
    </div>
  </section>

  {/* === CANALES RÁPIDOS === */}
  <section class="py-12 px-4 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

        {/* WhatsApp */}
        <a
          href="https://wa.me/51913249330?text=%C2%A1Hola!%20Vi%20su%20tienda%20Missy%20%26%20Po%20y%20me%20gustar%C3%ADa%20consultar%20sobre%20un%20producto%20%F0%9F%90%BE"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center gap-3 p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-200 group"
        >
          <div class="w-14 h-14 rounded-full flex items-center justify-center text-white text-2xl" style="background: #25D366;">
            💬
          </div>
          <div class="text-center">
            <h3 class="font-ui font-bold text-gray-800 group-hover:text-green-600 transition-colors">WhatsApp</h3>
            <p class="text-xs font-body text-gray-400 mt-1">+51 913 249 330</p>
          </div>
          <span class="text-xs font-ui font-semibold px-4 py-1.5 rounded-full bg-green-50 text-green-700">Más rápido</span>
        </a>

        {/* Telegram */}
        <a
          href="https://t.me/Missypo_bot"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center gap-3 p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-200 group"
        >
          <div class="w-14 h-14 rounded-full flex items-center justify-center text-white text-2xl" style="background: #0088CC;">
            ✈️
          </div>
          <div class="text-center">
            <h3 class="font-ui font-bold text-gray-800 group-hover:text-blue-600 transition-colors">Telegram</h3>
            <p class="text-xs font-body text-gray-400 mt-1">@Missypo_bot</p>
          </div>
          <span class="text-xs font-ui font-semibold px-4 py-1.5 rounded-full bg-blue-50 text-blue-700">Bot automático</span>
        </a>

        {/* Email */}
        <div class="flex flex-col items-center gap-3 p-6 rounded-2xl border border-gray-100 shadow-sm">
          <div class="w-14 h-14 rounded-full flex items-center justify-center text-white text-2xl" style="background: var(--color-coral);">
            📧
          </div>
          <div class="text-center">
            <h3 class="font-ui font-bold text-gray-800">Formulario</h3>
            <p class="text-xs font-body text-gray-400 mt-1">Más abajo</p>
          </div>
          <span class="text-xs font-ui font-semibold px-4 py-1.5 rounded-full bg-red-50" style="color: var(--color-coral);">Te contactamos</span>
        </div>
      </div>
    </div>
  </section>

  {/* === FORMULARIO + MAPA === */}
  <section class="py-16 px-4" style="background: var(--color-bg-light, #fafafa);">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        {/* Formulario */}
        <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm">
          <h2 class="font-hero text-2xl mb-6" style="color: var(--color-text-dark);">
            Escribinos
          </h2>
          <form id="contact-form" class="space-y-4">
            <div>
              <label for="contact-name" class="block text-xs font-ui font-semibold text-gray-600 mb-1.5">Nombre</label>
              <input
                id="contact-name"
                type="text"
                required
                placeholder="Tu nombre"
                class="w-full px-4 py-3 rounded-xl border text-sm font-body bg-gray-50 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                style="border-color: var(--color-border);"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-ui font-semibold text-gray-600 mb-1.5">Email</label>
              <input
                id="contact-email"
                type="email"
                required
                placeholder="tu@email.com"
                class="w-full px-4 py-3 rounded-xl border text-sm font-body bg-gray-50 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                style="border-color: var(--color-border);"
              />
            </div>
            <div>
              <label for="contact-phone" class="block text-xs font-ui font-semibold text-gray-600 mb-1.5">Teléfono / WhatsApp (opcional)</label>
              <input
                id="contact-phone"
                type="tel"
                placeholder="+51 999 999 999"
                class="w-full px-4 py-3 rounded-xl border text-sm font-body bg-gray-50 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                style="border-color: var(--color-border);"
              />
            </div>
            <div>
              <label for="contact-subject" class="block text-xs font-ui font-semibold text-gray-600 mb-1.5">Motivo</label>
              <select
                id="contact-subject"
                required
                class="w-full px-4 py-3 rounded-xl border text-sm font-body bg-gray-50 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                style="border-color: var(--color-border);"
              >
                <option value="">Seleccioná un motivo</option>
                <option value="consulta">Consulta sobre producto</option>
                <option value="pedido">Estado de pedido</option>
                <option value="envio">Consulta de envío</option>
                <option value="devolucion">Devolución o cambio</option>
                <option value="club">Club de beneficios</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div>
              <label for="contact-message" class="block text-xs font-ui font-semibold text-gray-600 mb-1.5">Mensaje</label>
              <textarea
                id="contact-message"
                required
                rows="4"
                placeholder="Contanos en qué te podemos ayudar..."
                class="w-full px-4 py-3 rounded-xl border text-sm font-body bg-gray-50 focus:outline-none focus:ring-2 focus:border-transparent transition-all resize-none"
                style="border-color: var(--color-border);"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full py-3.5 rounded-xl font-ui font-bold text-white text-sm transition-all duration-200 hover:opacity-90 shadow-sm"
              style="background: linear-gradient(135deg, var(--color-coral), var(--color-coral-dark));"
            >
              Enviar Mensaje
            </button>
            <p id="contact-success" class="text-center text-sm font-body text-green-600 hidden">
              ✅ ¡Mensaje enviado! Te contactamos pronto.
            </p>
          </form>
        </div>

        {/* Info + Mapa */}
        <div class="space-y-6">
          <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm">
            <h2 class="font-hero text-2xl mb-6" style="color: var(--color-text-dark);">
              Datos de contacto
            </h2>
            <div class="space-y-4 font-body text-gray-600 text-sm">
              <div class="flex items-start gap-3">
                <span class="text-lg">📍</span>
                <div>
                  <p class="font-semibold text-gray-800">Dirección</p>
                  <p>Diagonal Frente a Promelsa, Cooperativa Universitaria Mz I Lt 1, Arequipa 04001</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-lg">📱</span>
                <div>
                  <p class="font-semibold text-gray-800">WhatsApp</p>
                  <a href="https://wa.me/51913249330" target="_blank" rel="noopener noreferrer" class="hover:underline" style="color: var(--color-coral);">+51 913 249 330</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-lg">💬</span>
                <div>
                  <p class="font-semibold text-gray-800">Telegram</p>
                  <a href="https://t.me/Missypo_bot" target="_blank" rel="noopener noreferrer" class="hover:underline" style="color: var(--color-coral);">@Missypo_bot</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-lg">🕐</span>
                <div>
                  <p class="font-semibold text-gray-800">Horario</p>
                  <p>Martes a Sábado — 8:00 AM a 6:00 PM</p>
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-100 h-64">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3827.5!2d-71.53!3d-16.4!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTbCsDI0JzAwLjAiUyA3McKwMzEnNDguMCJX!5e0!3m2!1ses!2spe!4v1"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación Missy & Po Pet Shop Arequipa"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successMsg = document.getElementById('contact-success');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (successMsg) {
        successMsg.classList.remove('hidden');
        form.reset();
        setTimeout(() => successMsg.classList.add('hidden'), 5000);
      }
    });
  </script>
</Layout>
