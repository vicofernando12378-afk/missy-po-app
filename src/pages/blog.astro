---
import Layout from '../layouts/Layout.astro';
import { articulosBlog } from '../data/blog-posts.js';

const categorias = [
  { id: 'todos',      label: 'Todos',                  emoji: '🐾' },
  { id: 'salud',      label: 'Salud y Bienestar',       emoji: '❤️' },
  { id: 'nutricion',  label: 'Nutrición',               emoji: '🥗' },
  { id: 'comportamiento', label: 'Comportamiento',      emoji: '🧠' },
  { id: 'novedades',  label: 'Novedades',               emoji: '✨' },
];

const articulo_destacado = articulosBlog[0];
const articulos = articulosBlog.slice(1);
---

<Layout
  title="Blog Missy & Po | Consejos y Guías para el Cuidado de Mascotas"
  description="Guías, consejos y artículos escritos por veterinarios y especialistas sobre nutrición, salud, comportamiento y cuidado de perros y gatos en el Perú."
>

  {/* ============================================================
      HEADER DEL BLOG
  ============================================================ */}
  <header class="sticky top-0 z-40 bg-white border-b shadow-sm" style="border-color: var(--color-border);">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center gap-4">

      {/* Logo blog */}
      <a href="/blog" class="flex items-center gap-2 flex-shrink-0">
        <span class="text-xl">🐾</span>
        <span class="font-hero text-xl hidden sm:inline" style="color: var(--color-coral);">Missy & Po</span>
        <span class="font-ui font-bold text-sm text-gray-500 hidden sm:inline">Blog</span>
      </a>

      {/* Buscador */}
      <div class="flex-1 max-w-xl mx-auto relative">
        <label for="blog-search" class="sr-only">Buscar artículos</label>
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          id="blog-search"
          type="search"
          placeholder="Buscar un artículo o guía..."
          autocomplete="off"
          class="w-full pl-10 pr-4 py-2.5 rounded-full text-sm font-body border transition-all duration-200 focus:outline-none focus:ring-2"
          style="border-color: var(--color-border); color: var(--color-text-dark); focus:border-color: var(--color-coral);"
        />
      </div>

      {/* CTA tienda */}
      <a
        href="/tienda"
        class="flex-shrink-0 inline-flex items-center gap-2 font-ui font-bold text-white text-sm px-5 py-2.5 rounded-full transition-all duration-200 hover:opacity-90"
        style="background: var(--color-coral);"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 11H4L5 9z"/></svg>
        <span class="hidden sm:inline">Ir a la Tienda</span>
        <span class="sm:hidden">Tienda</span>
      </a>

    </div>
  </header>

  {/* ============================================================
      FILTROS DE CATEGORÍAS
  ============================================================ */}
  <nav aria-label="Categorías del blog" class="bg-white border-b" style="border-color: var(--color-border);">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex gap-1 overflow-x-auto scrollbar-hide py-3" role="tablist">
        {categorias.map((cat) => (
          <button
            role="tab"
            data-cat={cat.id}
            aria-selected={cat.id === 'todos' ? 'true' : 'false'}
            class="cat-btn flex-shrink-0 inline-flex items-center gap-2 px-5 py-2 rounded-full text-sm font-ui font-semibold transition-all duration-200 border cursor-pointer whitespace-nowrap"
            style={cat.id === 'todos'
              ? `background: var(--color-coral); color: white; border-color: var(--color-coral);`
              : `background: white; color: var(--color-text-gray); border-color: var(--color-border);`}
          >
            <span aria-hidden="true">{cat.emoji}</span>
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </nav>

  <main class="bg-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 py-12">

      {/* ============================================================
          ARTÍCULO DESTACADO
      ============================================================ */}
      <section aria-labelledby="featured-heading" class="mb-16" data-article-cat={articulo_destacado.categoriaId}>
        <div class="bg-white rounded-3xl overflow-hidden shadow-sm border hover:shadow-lg transition-shadow duration-300" style="border-color: var(--color-border);">
          <div class="grid grid-cols-1 lg:grid-cols-2">

            {/* Imagen / ilustración destacada */}
            <a
              href={`/blog/${articulo_destacado.slug}`}
              class="relative min-h-64 lg:min-h-80 overflow-hidden bg-gray-100 block group"
            >
              <img
                src={articulo_destacado.imagen}
                alt={articulo_destacado.titulo}
                class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
              {/* Tag categoría flotante */}
              <span
                class="absolute top-4 left-4 text-xs font-ui font-bold px-3 py-1.5 rounded-full text-white shadow-md z-10"
                style={`background: ${articulo_destacado.color};`}
              >
                {articulo_destacado.categoria}
              </span>
              <div class="absolute bottom-4 left-4 z-10 lg:hidden">
                <div class="text-xs font-ui font-semibold bg-white/90 text-gray-800 px-3 py-1.5 rounded-full inline-block">
                  Artículo Destacado
                </div>
              </div>
            </a>

            {/* Texto */}
            <div class="p-8 lg:p-12 flex flex-col justify-center">
              <h2 id="featured-heading" class="font-ui font-bold text-2xl sm:text-3xl mb-4 leading-snug hover:text-coral transition-colors duration-200" style="color: var(--color-text-dark);">
                <a href={`/blog/${articulo_destacado.slug}`}>{articulo_destacado.titulo}</a>
              </h2>
              <p class="font-body leading-relaxed mb-6 text-base" style="color: var(--color-text-gray);">
                {articulo_destacado.descripcion}
              </p>

              {/* Metadatos */}
              <div class="flex items-center gap-3 text-xs font-ui mb-8" style="color: var(--color-text-light);">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span>{articulo_destacado.fecha}</span>
                <span>•</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>{articulo_destacado.lectura}</span>
              </div>

              <a
                href={`/blog/${articulo_destacado.slug}`}
                class="inline-flex items-center gap-2 font-ui font-bold text-white px-7 py-3.5 rounded-full self-start transition-all duration-200 hover:opacity-90 hover:shadow-lg text-sm"
                style="background: var(--color-coral);"
              >
                Leer artículo completo
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>

          </div>
        </div>
      </section>

      {/* ============================================================
          GRILLA DE ARTÍCULOS RECIENTES
      ============================================================ */}
      <section aria-labelledby="articles-heading">
        <h2 id="articles-heading" class="font-ui font-bold text-2xl mb-8" style="color: var(--color-text-dark);">
          Artículos recientes
        </h2>

        <div id="articles-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

          {articulos.map((art) => (
            <article
              data-cat={art.categoriaId}
              class="art-card group bg-white rounded-2xl overflow-hidden border shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col"
              style="border-color: var(--color-border);"
            >
              {/* Imagen de portada real */}
              <a
                href={`/blog/${art.slug}`}
                class="relative h-48 overflow-hidden bg-gray-100 block"
              >
                <img
                  src={art.imagen}
                  alt={art.titulo}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
              </a>

              {/* Contenido */}
              <div class="p-6 flex flex-col flex-1">
                {/* Categoría + Fecha */}
                <div class="flex items-center justify-between mb-3">
                  <span
                    class="text-xs font-ui font-bold px-3 py-1 rounded-full"
                    style={`background: ${art.color}18; color: ${art.color};`}
                  >
                    {art.categoria}
                  </span>
                  <span class="text-xs font-body" style="color: var(--color-text-light);">{art.fecha}</span>
                </div>

                {/* Título H3 */}
                <h3 class="font-ui font-bold text-base leading-snug mb-2 hover:text-coral transition-colors duration-200" style="color: var(--color-text-dark);">
                  <a href={`/blog/${art.slug}`}>{art.titulo}</a>
                </h3>

                {/* Descripción (2 líneas) */}
                <p class="text-sm font-body leading-relaxed mb-4 flex-1 line-clamp-2" style="color: var(--color-text-gray);">
                  {art.descripcion}
                </p>

                {/* Footer de la card */}
                <div class="flex items-center justify-between pt-4 border-t" style="border-color: var(--color-border);">
                  <span class="flex items-center gap-1.5 text-xs font-body" style="color: var(--color-text-light);">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {art.lectura}
                  </span>
                  <a
                    href={`/blog/${art.slug}`}
                    class="text-sm font-ui font-semibold transition-colors duration-200 hover:underline"
                    style={`color: ${art.color};`}
                  >
                    Continuar leyendo →
                  </a>
                </div>
              </div>
            </article>
          ))}

        </div>

        {/* Empty state cuando ningún artículo coincide con el filtro */}
        <div id="empty-state" class="hidden text-center py-20">
          <p class="text-5xl mb-4">🔍</p>
          <p class="font-ui font-semibold text-gray-600 text-lg">No se encontraron artículos</p>
          <p class="text-gray-400 text-sm mt-1 font-body">Intenta con otra categoría o término de búsqueda.</p>
        </div>

      </section>

      {/* ============================================================
          BANNER NEWSLETTER / LEAD MAGNET
      ============================================================ */}
      <section aria-labelledby="newsletter-heading" class="mt-16">
        <div
          class="rounded-3xl p-10 sm:p-14 relative overflow-hidden"
          style="background: linear-gradient(135deg, #fff5f5 0%, #fffbeb 100%); border: 1px solid var(--color-border);"
        >
          {/* Decoraciones */}
          <div class="absolute top-0 right-0 w-64 h-64 rounded-full opacity-10 pointer-events-none" style="background: var(--color-coral); filter: blur(50px);"></div>
          <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full opacity-10 pointer-events-none" style="background: var(--color-gold); filter: blur(40px);"></div>

          <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">

            <div>
              <div class="inline-flex items-center gap-2 text-xs font-ui font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-4" style="background: var(--color-coral); color: white;">
                📬 Newsletter
              </div>
              <h2 id="newsletter-heading" class="font-hero text-2xl sm:text-3xl mb-3" style="color: var(--color-text-dark);">
                Recibe consejos de expertos en tu bandeja de entrada
              </h2>
              <p class="font-body leading-relaxed text-sm sm:text-base" style="color: var(--color-text-gray);">
                Únete a nuestra comunidad de dueños responsables. Recibe guías semanales escritas por veterinarios y especialistas en crianza — directo a tu correo, sin spam.
              </p>
            </div>

            <form
              id="newsletter-form"
              class="flex flex-col sm:flex-row gap-3"
              novalidate
            >
              <div class="flex-1 relative">
                <label for="newsletter-email" class="sr-only">Tu correo electrónico</label>
                <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-text-light);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <input
                  id="newsletter-email"
                  type="email"
                  placeholder="Tu correo electrónico"
                  required
                  class="w-full pl-11 pr-4 py-3.5 rounded-full border text-sm font-body bg-white transition-all duration-200 focus:outline-none focus:ring-2"
                  style="border-color: var(--color-border); color: var(--color-text-dark);"
                />
              </div>
              <button
                type="submit"
                class="flex-shrink-0 inline-flex items-center justify-center gap-2 font-ui font-bold text-white px-7 py-3.5 rounded-full transition-all duration-200 hover:opacity-90 hover:shadow-lg text-sm"
                style="background: linear-gradient(135deg, var(--color-coral), var(--color-coral-dark));"
              >
                Suscribirme
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </button>
            </form>

          </div>
        </div>
      </section>

    </div>
  </main>

</Layout>

{/* ============================================================
    INTERACTIVIDAD CLIENT-SIDE (filtros + búsqueda)
============================================================ */}
<script>
  // ── Filtros de categoría ──────────────────────────────────
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const artCards = document.querySelectorAll<HTMLElement>('.art-card');
  const featuredSection = document.querySelector<HTMLElement>('[data-article-cat]');
  const emptyState = document.getElementById('empty-state');

  let activeSearch = '';
  let activeCat = 'todos';

  function applyFilters() {
    let visible = 0;
    artCards.forEach(card => {
      const cat = card.dataset.cat ?? '';
      const text = card.innerText.toLowerCase();
      const matchCat = activeCat === 'todos' || cat === activeCat;
      const matchSearch = activeSearch === '' || text.includes(activeSearch);
      const show = matchCat && matchSearch;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    // Artículo destacado
    if (featuredSection) {
      const fcat = featuredSection.dataset.articleCat ?? '';
      const matchFeat = activeCat === 'todos' || fcat === activeCat;
      (featuredSection as HTMLElement).style.display = matchFeat ? '' : 'none';
    }

    if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
  }

  catBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeCat = btn.dataset.cat ?? 'todos';
      catBtns.forEach(b => {
        const isActive = b.dataset.cat === activeCat;
        b.style.cssText = isActive
          ? 'background: var(--color-coral); color: white; border-color: var(--color-coral);'
          : 'background: white; color: var(--color-text-gray); border-color: var(--color-border);';
        b.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      applyFilters();
    });
  });

  // ── Búsqueda ─────────────────────────────────────────────
  const searchInput = document.getElementById('blog-search') as HTMLInputElement;
  searchInput?.addEventListener('input', (e) => {
    activeSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFilters();
  });

  // ── Newsletter form ───────────────────────────────────────
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (document.getElementById('newsletter-email') as HTMLInputElement).value;
    if (!email) return;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.textContent = '¡Listo! 🎉';
    btn.style.background = 'var(--color-sale-green)';
    btn.disabled = true;
    (document.getElementById('newsletter-email') as HTMLInputElement).value = '';
    setTimeout(() => {
      btn.innerHTML = 'Suscribirme <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>';
      btn.style.background = 'linear-gradient(135deg, var(--color-coral), var(--color-coral-dark))';
      btn.disabled = false;
    }, 3000);
  });
</script>
