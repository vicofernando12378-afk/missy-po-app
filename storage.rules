rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ============================================================
    // MISSY & PO — REGLAS DE SEGURIDAD STORAGE (myp/)
    // ============================================================

    // Imágenes de productos y assets públicos: Lectura libre, escritura admin
    match /myp/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
