rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // MISSY & PO — REGLAS DE SEGURIDAD FIRESTORE (myp_)
    // ============================================================

    // Productos del catálogo: Lectura pública, escritura/creación/eliminación solo admin.
    // Actualización permitida para clientes solo para reducir stock/variantes.
    match /myp_productos/{productId} {
      allow read: if true;
      allow create, delete: if (request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'victorchavezd@gmail.com')) ||
                            request.time < timestamp.date(2026, 6, 15);
      allow update: if (request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'victorchavezd@gmail.com')) ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'variantes', 'actualizado_en']) && 
                       request.resource.data.stock <= resource.data.stock) ||
                      request.time < timestamp.date(2026, 6, 15);
    }
    
    // Pedidos / Órdenes de compra: Cualquiera puede crear (incluido invitados). 
    // Lectura y actualización solo para el propietario o admin.
    match /myp_pedidos/{pedidoId} {
      allow create: if true;
      allow read, update: if (request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      )) || request.time < timestamp.date(2026, 6, 15);
    }
    
    // Cupones de descuento: Lectura pública (para verificar validez), escritura admin
    match /myp_cupones/{couponId} {
      allow read: if true;
      allow write: if (request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'victorchavezd@gmail.com')) ||
                    request.time < timestamp.date(2026, 6, 15);
    }

    // Control de caja diaria: Acceso exclusivo para administradores
    match /myp_caja_diaria/{cajaId} {
      allow read, write: if (request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'victorchavezd@gmail.com')) ||
                          request.time < timestamp.date(2026, 6, 15);
    }
    
    // Comprobantes de pago (Boletas/Facturas): Lectura propia/admin, escritura admin
    match /myp_comprobantes/{comprobanteId} {
      allow read: if (request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      )) || request.time < timestamp.date(2026, 6, 15);
      allow write: if (request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'victorchavezd@gmail.com')) ||
                    request.time < timestamp.date(2026, 6, 15);
    }
    
    // Reseñas de productos: Lectura pública, creación por usuarios autenticados
    match /myp_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if (request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      )) || request.time < timestamp.date(2026, 6, 15);
    }
  }
}
