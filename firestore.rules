rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // MISSY & PO — REGLAS DE SEGURIDAD FIRESTORE (myp_)
    // ============================================================

    // Productos del catálogo: Lectura pública, escritura solo admin
    match /myp_productos/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Pedidos / Órdenes de compra: Cualquiera puede crear (incluido invitados). 
    // Lectura y actualización solo para el propietario o admin.
    match /myp_pedidos/{pedidoId} {
      allow create: if true;
      allow read, update: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
    }
    
    // Cupones de descuento: Lectura pública (para verificar validez), escritura admin
    match /myp_cupones/{couponId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Control de caja diaria: Acceso exclusivo para administradores
    match /myp_caja_diaria/{cajaId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Comprobantes de pago (Boletas/Facturas): Lectura propia/admin, escritura admin
    match /myp_comprobantes/{comprobanteId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Reseñas de productos: Lectura pública, creación por usuarios autenticados
    match /myp_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
    }
  }
}
