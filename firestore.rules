rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // MISSY & PO — REGLAS DE SEGURIDAD FIRESTORE (myp_)
    // ============================================================

    // Productos del catálogo: Lectura pública, escritura/creación/eliminación solo admin.
    // Actualización permitida para clientes solo para reducir stock/variantes.
    match /myp_productos/{productId} {
      allow read: if true;
      allow create, delete: if request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
      allow update: if (request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      )) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'variantes', 'actualizado_en']) && 
        request.resource.data.stock <= resource.data.stock
      );
    }
    
    // Pedidos / Órdenes de compra: Cualquiera puede crear (incluido invitados). 
    // get es público para la confirmación de compras, list/update solo propietarios o admin.
    match /myp_pedidos/{pedidoId} {
      allow create: if true;
      allow get: if true;
      allow list: if request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
    }

    // Cupones de descuento: Lectura pública (para verificar validez), escritura admin
    match /myp_cupones/{couponId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
    }

    // Control de caja diaria: Acceso exclusivo para administradores
    match /myp_caja_diaria/{cajaId} {
      allow read, write: if request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
    }
    
    // Comprobantes de pago (Boletas/Facturas): Lectura propia/admin, escritura admin
    match /myp_comprobantes/{comprobanteId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
      allow write: if request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
    }
    
    // Reseñas de productos: Lectura pública, creación por usuarios autenticados
    match /myp_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
    }

    // Miembros del Club: Creación, lectura y actualización públicas para permitir registro y canje en checkout
    match /myp_club_miembros/{miembroId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      );

      // Historial de puntos: Lectura y escritura pública para registro transaccional en checkout
      match /puntos_logs/{logId} {
        allow read, write: if true;
      }
    }

    // Configuración general (envíos, club, etc.): Lectura pública, escritura admin
    match /myp_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
    }

    // Perfiles de usuario: Cada usuario solo puede leer/escribir su propio perfil
    match /myp_user_profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
    }

    // Reclamaciones: Creación pública, administración (read, update, delete) restringida a administradores
    match /myp_reclamaciones/{reclamacionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
    }

    // Correos de salida (Trigger Email): Creación pública, administración restringida a administradores
    match /myp_correos/{correoId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'victorchavezd@gmail.com'
      );
    }
  }
}

