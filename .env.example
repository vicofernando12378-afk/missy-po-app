# === MISSY & PO — VARIABLES DE ENTORNO ===
# Copiar este archivo como .env y completar los valores reales

# --- Firebase Config ---
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Mercado Pago ---
# NUNCA exponer ACCESS_TOKEN en el frontend — se usa solo en Cloud Functions
VITE_MERCADOPAGO_PUBLIC_KEY=your_mp_public_key
# En Cloud Functions (NO en .env del frontend):
# MERCADOPAGO_ACCESS_TOKEN=your_access_token

# --- Culqi (Yape/Plin) ---
# NUNCA exponer SECRET_KEY en el frontend — se usa solo en Cloud Functions
VITE_CULQI_PUBLIC_KEY=your_culqi_public_key
# En Cloud Functions (NO en .env del frontend):
# CULQI_SECRET_KEY=your_secret_key

# --- WhatsApp ---
VITE_WHATSAPP_NUMBER=51999999999

# --- App Config ---
VITE_APP_NAME="Missy & Po Pet Shop"
VITE_APP_URL=https://missy-po-petshop.web.app
